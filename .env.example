# Environment-variable reference for local overrides.
# The application reads process environment variables and does not auto-load this file.
# Never place real secrets in this example or commit a populated .env file.
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=replace-with-a-long-random-local-value
APP_MAX_UPLOAD_BYTES=10485760
APP_MAX_CSV_ROWS=5000
APP_MAX_CSV_COLUMNS=200
APP_CSV_PREVIEW_ROWS=5
APP_OLLAMA_MODEL=llama3.2:latest
APP_OLLAMA_TIMEOUT_SECONDS=120
